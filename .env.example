# Environment Configuration Template
# Copy this file to .env and fill in your credentials

# General App Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0
# When set to true, external API calls (Airtable, Slack, Gmail) fallback to realistic mocks if keys are missing
MOCK_EXTERNAL_SERVICES_FALLBACK=true

# ==========================================
# Task 1: Lead Qualification Configuration
# ==========================================
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Airtable
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=appYourBaseId12345
AIRTABLE_TABLE_NAME=Leads

# Slack
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url_here
SLACK_SALES_CHANNEL=#sales-leads

# Target SLA constraint (seconds)
MAX_EXECUTION_SLA_SECONDS=10.0

# ==========================================
# Task 2: Email Triage Configuration
# ==========================================
# Gmail Integration (OAuth2 Client)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_TRIAGE_USER_ID=me

# Email Triage Thresholds
URGENT_SENTIMENT_THRESHOLD=0.35
AUTONOMOUS_DRAFT_ENABLED=true
